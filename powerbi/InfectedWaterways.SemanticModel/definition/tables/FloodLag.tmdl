	partition FloodLag = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "flood_lag.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"eventid", "iso3", "alert", "alert_order", "flood_week", "lag_week", "cases", "baseline", "ratio"}),
				    Nulls = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Nulls, {{"eventid", Int64.Type}, {"iso3", type text}, {"alert", type text}, {"alert_order", Int64.Type}, {"flood_week", type date}, {"lag_week", Int64.Type}, {"cases", Int64.Type}, {"baseline", type number}, {"ratio", type number}}, "en-US"),
				    #"Added lag_label" = Table.AddColumn(Typed, "lag_label", each if [lag_week] > 0 then "+" & Text.From([lag_week]) else Text.From([lag_week]), type text)
				in
				    #"Added lag_label"

	annotation PBI_ResultType = Table

