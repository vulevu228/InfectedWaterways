	partition Don = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "don.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"url_name", "published", "year", "title", "country", "iso3", "kind", "disease_group"}),
				    Nulls = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Nulls, {{"url_name", type text}, {"published", type date}, {"year", Int64.Type}, {"title", type text}, {"country", type text}, {"iso3", type text}, {"kind", type text}, {"disease_group", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

