table DimWeek
	lineageTag: 4a4a78af-5293-5b9b-841d-3446838f539e

	column week
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: ede0f52f-6c10-5d35-9847-2c9f4833ce0d
		summarizeBy: none
		sourceColumn: week

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column week_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: aec7522a-1c5f-50b3-9c6c-abdd0e194017
		summarizeBy: none
		sourceColumn: week_key

		annotation SummarizationSetBy = Automatic

	column iso_year
		dataType: int64
		formatString: 0
		lineageTag: 4602c4bb-f89a-518f-8ea3-9d385ec88ca7
		summarizeBy: none
		sourceColumn: iso_year

		annotation SummarizationSetBy = Automatic

	column iso_week
		dataType: int64
		formatString: 0
		lineageTag: 4783352e-417d-5d13-851e-63db51f38b8b
		summarizeBy: none
		sourceColumn: iso_week

		annotation SummarizationSetBy = Automatic

	column week_label
		dataType: string
		lineageTag: 42431fe1-b3d6-5997-b562-40c09bfb088e
		summarizeBy: none
		sourceColumn: week_label
		sortByColumn: week_key

		annotation SummarizationSetBy = Automatic

	partition DimWeek = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_week.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"week", "week_key", "iso_year", "iso_week", "week_label"}),
				    Nulls = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Nulls, {{"week", type date}, {"week_key", Int64.Type}, {"iso_year", Int64.Type}, {"iso_week", Int64.Type}, {"week_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

