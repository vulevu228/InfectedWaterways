	partition DimCountry = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "country.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"iso3", "country", "who_region", "pop", "pop_year", "basic_pct", "safe_pct", "wash_year", "unsafe_pct", "unsafe_band", "band_order", "has_cholera"}),
				    Nulls = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Nulls, {{"iso3", type text}, {"country", type text}, {"who_region", type text}, {"pop", Int64.Type}, {"pop_year", Int64.Type}, {"basic_pct", type number}, {"safe_pct", type number}, {"wash_year", Int64.Type}, {"unsafe_pct", type number}, {"unsafe_band", type text}, {"band_order", Int64.Type}}, "en-US"),
				    Flags = Table.TransformColumns(Typed, {{"has_cholera", each _ = "t", type logical}})
				in
				    Flags

	annotation PBI_ResultType = Table

