    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#111418"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#8A94A1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Result. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "No rise: the median stays below 1.00 before and after floods, and orange/red floods look the same.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Why it can hide a link. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "WHO counts are national and weekly; a local outbreak downstream of one flood is small next to the national total.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Floods. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "GDACS flood alerts (GloFAS-based), mostly green = small. Multi-country floods are left out.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Kept. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "A flood counts when its country has 4 + reported weeks with cases in weeks −12 to −5, and weeks −4 to +8 lie inside the data.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#8A94A1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Correlation, not cause. Uneven WHO reporting: a missing week is no report, not zero.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#8A94A1"
                    }
                  }
                ]
              }
            ]
          }
        }
